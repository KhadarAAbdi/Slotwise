{
  "info": {
    "name": "Slotwise API",
    "description": "Run the requests in order (or use the Collection Runner). Each step stores the ids it needs in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create session (capacity 1)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/sessions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Yoga\",\n  \"start\": \"{{start}}\",\n  \"end\": \"{{end}}\",\n  \"capacity\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Creates a session with one seat and stores its id in {{sessionId}} for the requests below."
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const start = new Date(Date.now() + 24 * 60 * 60 * 1000);",
              "const end = new Date(start.getTime() + 60 * 60 * 1000);",
              "pm.collectionVariables.set(\"start\", start.toISOString());",
              "pm.collectionVariables.set(\"end\", end.toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"returns the new id\", () => pm.expect(body.id).to.be.a(\"string\"));",
              "pm.test(\"Location header points at the session\", () =>",
              "    pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/sessions/\" + body.id));",
              "pm.collectionVariables.set(\"sessionId\", body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Get session",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/sessions/{{sessionId}}"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const s = pm.response.json();",
              "pm.test(\"capacity 1, nothing booked yet\", () => {",
              "    pm.expect(s.capacity).to.eql(1);",
              "    pm.expect(s.confirmedCount).to.eql(0);",
              "    pm.expect(s.waitlistCount).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Book seat - first person (Confirmed)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/sessions/{{sessionId}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"a@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test(\"first booking is Confirmed\", () => pm.expect(b.status).to.eql(\"Confirmed\"));",
              "pm.collectionVariables.set(\"firstBookingId\", b.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Book seat - second person (Waitlisted)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/sessions/{{sessionId}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"b@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test(\"session is full, so the booking is Waitlisted\", () => pm.expect(b.status).to.eql(\"Waitlisted\"));",
              "pm.collectionVariables.set(\"secondBookingId\", b.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Book the same email again (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/sessions/{{sessionId}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"a@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
              "pm.test(\"error is problem+json\", () =>",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Book with an invalid email (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/sessions/{{sessionId}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"not-an-email\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. List sessions",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/sessions"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const all = pm.response.json();",
              "pm.test(\"contains the session created above\", () =>",
              "    pm.expect(all.some(s => s.id === pm.collectionVariables.get(\"sessionId\"))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Cancel the first booking (204, promotes the waitlist)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/sessions/{{sessionId}}/bookings/{{firstBookingId}}"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Get session - waitlisted person was promoted",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/sessions/{{sessionId}}"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const s = pm.response.json();",
              "const byId = Object.fromEntries(s.bookings.map(b => [b.id, b.status]));",
              "pm.test(\"first booking is Cancelled\", () => pm.expect(byId[pm.collectionVariables.get(\"firstBookingId\")]).to.eql(\"Cancelled\"));",
              "pm.test(\"second booking was promoted to Confirmed\", () => pm.expect(byId[pm.collectionVariables.get(\"secondBookingId\")]).to.eql(\"Confirmed\"));",
              "pm.test(\"counts match\", () => {",
              "    pm.expect(s.confirmedCount).to.eql(1);",
              "    pm.expect(s.waitlistCount).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Get an unknown session (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/sessions/00000000-0000-0000-0000-000000000000"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Create a session with capacity 0 (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/sessions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Broken\",\n  \"start\": \"{{start}}\",\n  \"end\": \"{{end}}\",\n  \"capacity\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const start = new Date(Date.now() + 24 * 60 * 60 * 1000);",
              "const end = new Date(start.getTime() + 60 * 60 * 1000);",
              "pm.collectionVariables.set(\"start\", start.toISOString());",
              "pm.collectionVariables.set(\"end\", end.toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Cancel an unknown booking (400)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/sessions/{{sessionId}}/bookings/00000000-0000-0000-0000-000000000000",
        "description": "Currently 400 rather than 404, because the domain raises a plain InvalidOperationException for an unknown booking."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400 Bad Request (the domain rejects it as a rule violation)\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5017"
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "firstBookingId",
      "value": ""
    },
    {
      "key": "secondBookingId",
      "value": ""
    },
    {
      "key": "start",
      "value": ""
    },
    {
      "key": "end",
      "value": ""
    }
  ]
}
